---
// The Shruggie Agency page (/agentur, /en/agency), in the Agency theme from the design system:
// acid-yellow hero with ink type, ink sections with acid accents, rust only as the single spark.
// The preferred way of working is the small marketing team (a month in four steps and a "from"
// price, no fixed packages); the examples show the range without turning it into product lines;
// "something else" stays open for one-off projects. The work section appears once
// agency.work.items has entries. The price is "ab ¯\_(ツ)_/¯ im Monat" on purpose: offers are
// individual, and the note under it says so.
import Base from "../../layouts/Base.astro";
import Backdrop from "./Backdrop.astro";
import V2Header from "./V2Header.astro";
import V2Contact from "./V2Contact.astro";
import V2Footer from "./V2Footer.astro";
import PriceText from "./PriceText.astro";
import { priceReady } from "./price";
import { content, routes, type Lang } from "../../i18n";
import "../../styles/v2.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = content[lang].agency;
const o = content[lang].office;
const words = a.hero.eyebrow.split(" · ");
const num = (i: number) => String(i + 1);
const work = a.work.items as { client: string; title: string; body: string }[];
const [teamId, examplesId] = a.nav.map((n) => n.href.slice(1));

const price = a.team.price;
const priceShown = priceReady(price.value);
---

<Base lang={lang} page="agency">
  <div class="v2" data-bg="wallpaper" data-theme="agency">
    <V2Header lang={lang} brand="agency" />

    <main id="main">
      <!-- Hero: acid-yellow field, ink headline, what the team does typed one after another. -->
      <section class="v2-hero">
        <Backdrop tone="acid" />
        <div class="v2-wrap v2-hero__inner">
          <h1 class="v2-hero__title">{a.hero.title}</h1>
          <p class="v2-hero__typed" aria-label={words.join(", ")}>
            <span aria-hidden="true"><span data-typed data-words={JSON.stringify(words)}>{words[0]}</span><span class="v2-cursor">_</span></span>
          </p>
        </div>
      </section>

      <!-- Intro: who we are for and two ways in, next to the brand panel. -->
      <section class="v2-intro">
        <div class="v2-wrap v2-intro__grid">
          <div>
            <h2 class="v2-h2">{a.intro.title}</h2>
            <p class="v2-lead">{a.intro.body}</p>
            <div class="v2-buttons">
              <a class="v2-btn" href="#contact">{a.intro.cta}</a>
              <a class="v2-btn" href={`#${teamId}`}>{a.intro.secondary}</a>
            </div>
          </div>
          <div class="v2-panel" aria-hidden="true">
            <span class="v2-panel__shrug shrug-logo"><span class="shrug-arm-l">¯\_(</span><span class="shrug-face">ツ</span><span class="shrug-arm-r">)_/¯</span></span>
            <span class="v2-panel__name">Shruggie<span class="v2-dot">.</span></span>
            <span class="v2-panel__desc">Agency</span>
          </div>
        </div>
      </section>

      <!-- The preferred way of working: the team, the month in four steps, the "from" price. -->
      <section id={teamId} class="v2-cards-section v2-cards-section--dark" aria-labelledby="v2-team">
        <Backdrop tone="ink" offset={1} />
        <div class="v2-wrap v2-split">
          <div class="v2-split__text">
            <div class="v2-eyebrow v2-eyebrow--on-dark">{a.team.eyebrow}</div>
            <h2 id="v2-team" class="v2-h2">{a.team.title}</h2>
            <p>{a.team.body}</p>
            <p>{a.team.network}</p>
            {priceShown && (
              <div class="v2-price">
                <div class="v2-price__label">{price.label}</div>
                <div class="v2-price__value"><PriceText text={price.value} label={price.shrugLabel} /></div>
                <p class="v2-price__note">{price.note}</p>
              </div>
            )}
            {!priceShown && <p class="v2-price__note">{price.note}</p>}
            <a class="v2-btn v2-btn--on-dark" href="#contact">{a.intro.cta}</a>
          </div>
          <ol class="v2-cardgrid" role="list">
            {a.team.steps.map((s, i) => (
              <li class="v2-card">
                <span class="v2-card__num" aria-hidden="true">{num(i)}</span>
                <div class="v2-card__label">{s.range}</div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- What the team does, for example: range without product lines, then the open door. -->
      <section id={examplesId} class="v2-cards-section v2-cards-section--light" aria-labelledby="v2-examples">
        <div class="v2-wrap v2-split">
          <div class="v2-split__text">
            <div class="v2-eyebrow">{a.examples.eyebrow}</div>
            <h2 id="v2-examples" class="v2-h2">{a.examples.title}</h2>
            <p>{a.examples.body}</p>
          </div>
          <div class="v2-cardgrid">
            {a.examples.items.map((s) => (
              <article class="v2-card">
                <div class="v2-card__label">{s.label}</div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </article>
            ))}
            <article class="v2-card v2-card--ink v2-card--wide">
              <h3>{a.examples.more.title}</h3>
              <p>{a.examples.more.body}</p>
              <a class="v2-btn v2-btn--on-dark" href="#contact">{a.examples.more.cta}</a>
            </article>
          </div>
        </div>
      </section>

      <!-- Teaser for the live pixel office (/agentur/office). -->
      <section class="v2-cards-section office-teaser" aria-labelledby="v2-office">
        <div class="v2-wrap">
          <a class="v2-card v2-card--line office-teaser__card" href={routes.office[lang]}>
            <div class="v2-eyebrow"><span class="office-teaser__dot" aria-hidden="true"></span>{o.teaser.eyebrow}</div>
            <h2 id="v2-office" class="v2-h2">{o.teaser.title}</h2>
            <p>{o.teaser.body}</p>
            <span class="v2-btn">{o.teaser.cta}</span>
          </a>
        </div>
      </section>

      {work.length > 0 && (
        <section id="work" class="v2-cards-section" aria-labelledby="v2-work">
          <div class="v2-wrap">
            <div class="v2-eyebrow">{a.work.eyebrow}</div>
            <h2 id="v2-work" class="v2-h2">{a.work.title}</h2>
            <div class="v2-cardgrid">
              {work.map((w) => (
                <article class="v2-card v2-card--line">
                  <div class="v2-card__label">{w.client}</div>
                  <h3>{w.title}</h3>
                  <p>{w.body}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <V2Contact lang={lang} brand="agency" />
    </main>

    <V2Footer lang={lang} brand="agency" />
  </div>
</Base>

<script>
  import { initV2 } from "../../scripts/v2";
  initV2();
</script>

<style is:global>
  .office-teaser__card { display: block; text-decoration: none; color: inherit; }
  .office-teaser__card .v2-eyebrow { display: inline-flex; align-items: center; gap: 10px; }
  .office-teaser__dot { width: 9px; height: 9px; background: var(--rust, #f51d31); animation: office-teaser-blink 1.4s steps(1) infinite; }
  @keyframes office-teaser-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .office-teaser__dot { animation: none; } }
  .office-teaser__card:hover .v2-btn { background: var(--ink); color: var(--cream); }
</style>

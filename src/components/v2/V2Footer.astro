---
// Dark three-column footer for both brands. The legal block stays the same (one business);
// the right column links to the other brand.
import { content, routes, ui, workspaceUrl, type Lang } from "../../i18n";
import type { Brand } from "./brand";

interface Props {
  lang: Lang;
  brand: Brand;
}

const { lang, brand } = Astro.props;
const agency = brand === "agency";
const legal = content[lang].home.footer;
const link = content[lang].agency.link;
const note = agency ? content[lang].agency.footer.note : legal.note;
---

<footer class="v2-footer">
  <div class="v2-wrap v2-footer__grid">
    <div>
      <p>Shruggie Consulting<br />Benjamin Birkelbach<br />{lang === "de" ? "München" : "Munich"}</p>
      <p class="v2-footer__small">{note}</p>
    </div>
    <div class="v2-footer__center">
      <span class="v2-brand__name">Shruggie<span class="v2-dot">.</span>{agency && <span class="v2-brand__desc">Agency</span>}</span>
      <a href="mailto:hello@shruggie.consulting">hello@shruggie.consulting</a>
    </div>
    <nav class="v2-footer__links" aria-label={lang === "de" ? "Weitere Seiten" : "More pages"}>
      <a href={agency ? routes.home[lang] : routes.agency[lang]}>{agency ? link.backFooter : link.footer}</a>
      <a href={routes.imprint[lang]}>{legal.imprint}</a>
      <a href={routes.privacy[lang]}>{legal.privacy}</a>
      <a href={workspaceUrl(lang)}>{ui[lang].clientWorkspace}</a>
    </nav>
  </div>
</footer>

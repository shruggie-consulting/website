---
// The Shruggie Consulting page (/consulting, /en/consulting; the home page from 4 Nov 2026
// until the house page took the root. The older HomePage.astro is no longer routed). Layout inspired by agenturwerft.com, in Shruggie's colours, type and backdrops.
// Big colour hero with a typed line, a two-column intro, a grey band with the facts,
// sections of numbered cards, FAQ as a chat, contact form, dark three-column footer.
// Header, contact and footer are shared with the Agency page (V2Header, V2Contact, V2Footer).
import Base from "../../layouts/Base.astro";
import Backdrop from "./Backdrop.astro";
import V2Header from "./V2Header.astro";
import V2Contact from "./V2Contact.astro";
import V2Footer from "./V2Footer.astro";
import PriceText from "./PriceText.astro";
import { priceReady } from "./price";
import { content, type Lang } from "../../i18n";
import "../../styles/v2.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = content[lang].home;

const quote = h.quote as { text: string; author: string } | null;
const words = h.hero.eyebrow.split(" · ");
const num = (i: number) => String(i + 1);
---

<Base lang={lang} page="consulting">
  <div class="v2" data-bg="wallpaper" data-theme="consulting">
    <V2Header lang={lang} brand="consulting" />

    <main id="main">
      <!-- Hero: colour field, big headline, the three topics typed one after another. -->
      <section class="v2-hero">
        <Backdrop tone="red" />
        <div class="v2-wrap v2-hero__inner">
          <h1 class="v2-hero__title">{h.hero.title}</h1>
          <p class="v2-hero__typed" aria-label={words.join(", ")}>
            <span aria-hidden="true"><span data-typed data-words={JSON.stringify(words)}>{words[0]}</span><span class="v2-cursor">_</span></span>
          </p>
        </div>
      </section>

      <!-- Intro: the promise and two ways in, next to the brand panel. -->
      <section class="v2-intro">
        <div class="v2-wrap v2-intro__grid">
          <div>
            <h2 class="v2-h2">{h.about.title}</h2>
            <p class="v2-lead">{h.hero.body}</p>
            <div class="v2-buttons">
              <a class="v2-btn" href="#contact">{h.hero.cta}</a>
              <a class="v2-btn" href="#services">{h.hero.secondary}</a>
            </div>
          </div>
          <div class="v2-panel" aria-hidden="true">
            <span class="v2-panel__shrug shrug-logo"><span class="shrug-arm-l">¯\_(</span><span class="shrug-face">ツ</span><span class="shrug-arm-r">)_/¯</span></span>
            <span class="v2-panel__name">Shruggie<span class="v2-cursor v2-cursor--sage">_</span></span>
          </div>
        </div>
      </section>

      <!-- Grey band: the story in short and the facts, like a row of references. -->
      <section id="about" class="v2-band">
        <div class="v2-wrap">
          <div class="v2-band__head">
            <div class="v2-eyebrow">{h.about.eyebrow}</div>
            {h.about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <dl class="v2-facts">
            {h.stats.map((st) => (
              <div class="v2-fact v2-fact--stat">
                <dt>{st.value}</dt>
                <dd>{st.caption}</dd>
              </div>
            ))}
            {h.about.rows.map((r) => (
              <div class="v2-fact">
                <dt>{r.label}</dt>
                <dd>{r.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      {quote && (
        <section class="v2-quote">
          <figure class="v2-wrap">
            <blockquote><p>„{quote.text}“</p></blockquote>
            <figcaption>{quote.author}</figcaption>
          </figure>
        </section>
      )}

      <!-- Problems: text on the left, numbered cards on the right, on a dark field. -->
      <section class="v2-cards-section v2-cards-section--dark" aria-labelledby="v2-problems">
        <Backdrop tone="ink" offset={1} />
        <div class="v2-wrap v2-split">
          <div class="v2-split__text">
            <div class="v2-eyebrow v2-eyebrow--on-dark">{h.problems.eyebrow}</div>
            <h2 id="v2-problems" class="v2-h2">{h.problems.title}</h2>
            <a class="v2-btn v2-btn--on-dark" href="#contact">{h.hero.cta}</a>
          </div>
          <div class="v2-cardgrid">
            {h.problems.items.map((p, i) => (
              <article class:list={["v2-card", { "v2-card--wide": i === h.problems.items.length - 1 && h.problems.items.length % 2 === 1 }]}>
                <span class="v2-card__num" aria-hidden="true">{num(i)}</span>
                <div class="v2-card__label">{p.eyebrow}</div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Offers: intro on the left, the three offers and "something else" as cards. -->
      <section id="services" class="v2-cards-section v2-cards-section--light" aria-labelledby="v2-services">
        <div class="v2-wrap v2-split">
          <div class="v2-split__text">
            <div class="v2-eyebrow">{h.services.eyebrow}</div>
            <h2 id="v2-services" class="v2-h2">{h.services.title}</h2>
            <p>{h.services.body}</p>
          </div>
          <div class="v2-cardgrid">
            {h.services.items.map((s) => (
              <article class:list={["v2-card", { "v2-card--accent": s.accent }]}>
                <span class="v2-card__num" aria-hidden="true">{Number(s.num)}</span>
                <div class="v2-card__label">
                  {s.label.join(" · ")}
                  {priceReady(s.price) && (
                    <>
                      {" · "}
                      <span class="v2-nowrap"><PriceText text={s.price} label={h.services.shrugLabel} /></span>
                    </>
                  )}
                </div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <details class="v2-more">
                  <summary>{h.services.getsLabel}</summary>
                  <dl class="v2-points">
                    {s.points.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                  <ul role="list" class="v2-gets">{s.gets.map((g) => <li>{g}</li>)}</ul>
                  {"note" in s && s.note && <p class="v2-note">{s.note}</p>}
                </details>
              </article>
            ))}
            <article class="v2-card v2-card--ink">
              <span class="v2-card__num" aria-hidden="true">{Number(h.services.more.num)}</span>
              <h3>{h.services.more.title}</h3>
              <p>{h.services.more.body}</p>
              <a class="v2-btn v2-btn--on-dark" href="#contact">{h.services.more.cta}</a>
            </article>
          </div>
        </div>
      </section>

      <!-- Way of working: what comes along, what stays outside. -->
      <section class="v2-keep" aria-labelledby="v2-keep">
        <div class="v2-wrap">
          <div class="v2-eyebrow">{h.keepBin.eyebrow}</div>
          <h2 id="v2-keep" class="v2-h2">{h.keepBin.title}</h2>
          <div class="v2-keep__grid">
            <div>
              <h3 class="v2-keep__title">{h.keepBin.keep.title}</h3>
              <ul role="list">{h.keepBin.keep.items.map((i) => <li><strong>{i.title}</strong> {i.text}</li>)}</ul>
            </div>
            <div class="v2-keep__bin">
              <h3 class="v2-keep__title">{h.keepBin.bin.title}</h3>
              <ul role="list">{h.keepBin.bin.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Approach: three weeks as cards, the capacity as the fourth. -->
      <section id="approach" class="v2-cards-section v2-cards-section--red" aria-labelledby="v2-approach">
        <Backdrop tone="red" offset={2} />
        <div class="v2-wrap v2-split">
          <div class="v2-split__text">
            <div class="v2-eyebrow v2-eyebrow--on-red">{h.approach.eyebrow}</div>
            <h2 id="v2-approach" class="v2-h2">{h.approach.title}</h2>
            <a class="v2-btn v2-btn--on-dark" href="#contact">{h.hero.cta}</a>
          </div>
          <ol class="v2-cardgrid" role="list">
            {h.approach.steps.map((s, i) => (
              <li class="v2-card">
                <span class="v2-card__num" aria-hidden="true">{num(i)}</span>
                <div class="v2-card__label">{s.range}</div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
            <li class="v2-card v2-card--ink">
              <div class="v2-card__label v2-card__label--sage">{h.heroAside.eyebrow}</div>
              <p class="v2-capacity"><span>{h.heroAside.value}</span> {h.heroAside.unit}</p>
              <p>{h.heroAside.text}</p>
              <a class="v2-textlink" href="#contact">{h.heroAside.link} →</a>
            </li>
          </ol>
        </div>
      </section>

      <!-- Questions as a short conversation: the question as a message, the answer as the reply. -->
      <section class="v2-faq" aria-labelledby="v2-faq">
        <div class="v2-wrap v2-faq__grid">
          <div class="v2-faq__head">
            <div class="v2-eyebrow">{h.faq.eyebrow}</div>
            <h2 id="v2-faq" class="v2-h2">{h.faq.title}</h2>
          </div>
          <dl class="v2-chat">
            {h.faq.items.map((f) => (
              <div class="v2-chat__pair">
                <dt class="v2-chat__q">{f.q}</dt>
                <dd class="v2-chat__a">
                  <span class="v2-chat__avatar" aria-hidden="true">ツ</span>
                  <p>{f.a}</p>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <V2Contact lang={lang} brand="consulting" />
    </main>

    <V2Footer lang={lang} brand="consulting" />
  </div>
</Base>

<script>
  import { initV2 } from "../../scripts/v2";
  initV2();
</script>

---
// Low-poly background: a jittered grid of triangles in shades of one colour, drawn once
// at build time (no image file, no script). Sits behind a section's content.
interface Props {
  /** Base colour as OKLCH parts. */
  l: number;
  c: number;
  h: number;
  /** How far the shades spread in lightness. */
  spread?: number;
  seed?: number;
}
const { l, c, h, spread = 0.07, seed = 7 } = Astro.props;

let s = seed;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const W = 1600, H = 900, cols = 14, rows = 8;
const pts: [number, number][][] = [];
for (let r = 0; r <= rows; r++) {
  pts.push([]);
  for (let q = 0; q <= cols; q++) {
    const edgeX = q === 0 || q === cols, edgeY = r === 0 || r === rows;
    const x = (q / cols) * W + (edgeX ? 0 : (rand() - 0.5) * (W / cols) * 0.8);
    const y = (r / rows) * H + (edgeY ? 0 : (rand() - 0.5) * (H / rows) * 0.8);
    pts[r].push([Math.round(x), Math.round(y)]);
  }
}
const tris: { d: string; fill: string }[] = [];
const shade = (x: number, y: number) => {
  // Lighter towards the top left, darker bottom right, plus noise.
  const t = 0.5 - (x / W) * 0.45 - (y / H) * 0.35 + (rand() - 0.5) * 0.5;
  return `oklch(${(l + t * spread).toFixed(3)} ${c} ${h})`;
};
for (let r = 0; r < rows; r++) {
  for (let q = 0; q < cols; q++) {
    const a = pts[r][q], b = pts[r][q + 1], d = pts[r + 1][q], e = pts[r + 1][q + 1];
    const flip = (r + q) % 2 === 0;
    const t1 = flip ? [a, b, e] : [a, b, d];
    const t2 = flip ? [a, e, d] : [b, e, d];
    for (const t of [t1, t2]) {
      const cx = (t[0][0] + t[1][0] + t[2][0]) / 3, cy = (t[0][1] + t[1][1] + t[2][1]) / 3;
      tris.push({ d: `M${t[0].join(",")}L${t[1].join(",")}L${t[2].join(",")}Z`, fill: shade(cx, cy) });
    }
  }
}
---

<svg class="poly" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {tris.map((t) => <path d={t.d} fill={t.fill} stroke={t.fill} stroke-width="1" />)}
</svg>

---
import Base from "../layouts/Base.astro";
import HomeHeader from "./HomeHeader.astro";
import { content, routes, ui, workspaceUrl, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = content[lang].home;

// Prices still to be set are written as {{PREIS_…}} in the content. While developing they
// show highlighted; the published site leaves the price out until it is filled in.
const DEV = import.meta.env.DEV;
const TOKEN = /(\{\{[A-Z_]+\}\})/;
const quote = h.quote as { text: string; author: string } | null;
const priceShown = (price?: string) => !!price && (DEV || !TOKEN.test(price));
---

<Base lang={lang} page="home">
  <HomeHeader lang={lang} />

  <main id="main">
    <section class="on-dark">
      <div class="wrap hero">
        <div>
          <div class="eyebrow eyebrow--on-dark">{h.hero.eyebrow}</div>
          <h1 class="display display--caps">{h.hero.title}</h1>
          <p class="hero__body">{h.hero.body}</p>
          <div class="hero__ctas">
            <a class="btn btn--lg" href="#contact">{h.hero.cta}</a>
            <a class="btn btn--lg btn--ghost" href="#services">{h.hero.secondary}</a>
          </div>
        </div>
        <!-- Proof next to the call to action: capacity is deliberately small. -->
        <aside class="hero__aside" aria-label={h.heroAside.eyebrow}>
          <div class="eyebrow eyebrow--on-dark">{h.heroAside.eyebrow}</div>
          <p class="capacity">
            <span class="capacity__value">{h.heroAside.value}</span>
            <span class="capacity__unit">{h.heroAside.unit}</span>
          </p>
          <p class="capacity__text">{h.heroAside.text}</p>
          <a class="capacity__link" href="#contact">{h.heroAside.link} →</a>
        </aside>
      </div>
    </section>

    <section class="on-alt problems" aria-labelledby="problems-title">
      <div class="wrap section-head">
        <div class="eyebrow eyebrow--on-light">{h.problems.eyebrow}</div>
        <h2 id="problems-title" class="display">{h.problems.title}</h2>
      </div>
      <div class="wrap problems__grid">
        {
          h.problems.items.map((p) => (
            <article class="problem">
              <div class="eyebrow eyebrow--on-light problem__eyebrow">{p.eyebrow}</div>
              <h3 class="display">{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- What comes along from the network world, and what stays outside. -->
    <section class="keepbin-section" aria-labelledby="keepbin-title">
      <div class="wrap section-head">
        <div class="eyebrow eyebrow--on-light">{h.keepBin.eyebrow}</div>
        <h2 id="keepbin-title" class="display">{h.keepBin.title}</h2>
      </div>
      <div class="wrap keepbin">
        <article class="keepbin__col keepbin__col--keep">
          <h3 class="eyebrow eyebrow--on-light">{h.keepBin.keep.title}</h3>
          <ul role="list">
            {h.keepBin.keep.items.map((i) => <li><strong>{i.title}</strong> — {i.text}</li>)}
          </ul>
        </article>
        <article class="keepbin__col keepbin__col--bin">
          <h3 class="eyebrow eyebrow--on-light">{h.keepBin.bin.title}</h3>
          <ul role="list">
            {h.keepBin.bin.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <section class="proof" aria-label={h.proof.eyebrow}>
      <div class="wrap stats">
        {
          h.stats.map((s) => (
            <div>
              <div class:list={["stat__value", { "stat__value--accent": s.accent }]}>{s.value}</div>
              <div class="stat__caption">{s.caption}</div>
            </div>
          ))
        }
      </div>
      {
        h.proof.cases.length > 0 && (
          <div class="wrap cases">
            {h.proof.cases.map((c: { client: string; before: string; after: string; text: string }) => (
              <article class="case">
                <div class="eyebrow eyebrow--on-light">{c.client}</div>
                <p class="case__numbers"><span>{c.before}</span> → <strong>{c.after}</strong></p>
                <p>{c.text}</p>
              </article>
            ))}
          </div>
        )
      }
    </section>

    <section id="about" class="on-alt">
      <div class="wrap about about--solo">
        <div class="about__text">
          <div class="eyebrow eyebrow--on-light">{h.about.eyebrow}</div>
          <h2 class="display">{h.about.title}</h2>
          {/* BENNI: verify every factual claim before publishing */}
          {h.about.paragraphs.map((p) => <p>{p}</p>)}
          <dl class="facts">
            {
              h.about.rows.map((r) => (
                <div class="fact">
                  <dt>{r.label}</dt>
                  <dd>{r.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        {/* Portrait slot, off for now. To restore: put the figure back and drop "about--solo" above.
        <figure class="portrait">
          <img src={h.about.portrait.src} alt={h.about.portrait.alt} width={h.about.portrait.width} height={h.about.portrait.height} loading="lazy" decoding="async" />
        </figure>
        */}
      </div>
    </section>

    <section id="services" class="on-dark services">
      <div class="wrap section-head">
        <div class="eyebrow eyebrow--on-dark">{h.services.eyebrow}</div>
        <h2 class="display">{h.services.title}</h2>
      </div>
      <div class="wrap services__grid">
        {
          h.services.items.map((s) => (
            <article class:list={["service", { "service--accent": s.accent }]}>
              <div class="service__num" aria-hidden="true">{s.num}</div>
              <h3 class="display">{s.title}</h3>
              <p class="service__label">
                {s.label.join(" · ")}
                {priceShown(s.price) && (
                  <>
                    {" · "}
                    {s.price.split(TOKEN).map((part) => (TOKEN.test(part) ? <mark class="todo">{part}</mark> : part))}
                  </>
                )}
              </p>
              <p>{s.body}</p>
              {"points" in s && s.points && (
                <dl class="service__points">
                  {s.points.map(([k, v]) => (
                    <div>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {"after" in s && s.after && <p class="service__after">{s.after}</p>}
              <div class="service__tags">{s.tags}</div>
            </article>
          ))
        }
      </div>
      <p class="wrap services__more">
        {h.services.more.text} <a href="#contact">{h.services.more.link}</a>
      </p>
      <div class="services__spacer"></div>
    </section>

    <section id="approach" class="on-alt approach">
      <div class="wrap section-head">
        <div class="eyebrow eyebrow--on-light">{h.approach.eyebrow}</div>
        <h2 class="display">{h.approach.title}</h2>
      </div>
      <ol class="wrap steps" role="list">
        {
          h.approach.steps.map((s) => (
            <li class="step">
              <div class="step__range">{s.range}</div>
              <h3 class="display">{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {/* Client quote: only real ones, and only when there is one. In the content file, replace
         "quote": null with e.g.
         "quote": { "text": "…", "author": "Gründer, Agentur, München" }  (EN: "Founder, agency, Munich") */}
    {quote && (
      <section class="quote">
        <figure class="wrap">
          <blockquote>
            <p class="display">{quote.text}</p>
          </blockquote>
          <figcaption>
            <p class="quote__author">{quote.author}</p>
          </figcaption>
        </figure>
      </section>
    )}

    <section id="contact" class="on-dark">
      <div class="wrap contact">
        <div>
          <div class="eyebrow eyebrow--on-dark">{h.contact.eyebrow}</div>
          <h2 class="display">{h.contact.title}</h2>
          <p class="contact__body">{h.contact.body}</p>
          <form class="contact-form" data-contact-form data-lang={lang} novalidate>
            <h3 class="contact-form__title">{h.contact.form.title}</h3>
            <div class="contact-form__grid">
              <label class="cf-field">
                <span>{h.contact.form.name}</span>
                <input name="name" autocomplete="name" required maxlength="200" />
              </label>
              <label class="cf-field">
                <span>{h.contact.form.company} <em>({h.contact.form.optional})</em></span>
                <input name="company" autocomplete="organization" maxlength="200" />
              </label>
              <label class="cf-field">
                <span>{h.contact.form.email}</span>
                <input name="email" type="email" autocomplete="email" required maxlength="254" />
              </label>
              <label class="cf-field">
                <span>{h.contact.form.phone} <em>({h.contact.form.optional})</em></span>
                <input name="phone" type="tel" autocomplete="tel" maxlength="60" />
              </label>
              <label class="cf-field cf-field--wide">
                <span>{h.contact.form.message}</span>
                <textarea name="message" rows="4" required maxlength="5000" placeholder={h.contact.form.messagePlaceholder}></textarea>
              </label>
            </div>
            <!-- Left empty by people; bots fill it in. -->
            <div class="cf-trap" aria-hidden="true">
              <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <label class="cf-consent">
              <input type="checkbox" name="consent" required />
              <span>{h.contact.form.consent} <a href={routes.privacy[lang]}>{h.contact.form.consentLink}</a>.</span>
            </label>
            <button class="cf-submit" type="submit">{h.contact.form.submit}</button>
            <p class="cf-status" role="status" aria-live="polite" data-status></p>
            <script type="application/json" data-messages set:html={JSON.stringify({ sending: h.contact.form.sending, sent: h.contact.form.sent, errors: h.contact.form.errors })} />
          </form>
        </div>
        <dl class="contact-list">
          {
            h.contact.rows.map((r) => (
              <div class="contact-row">
                <dt>{r.label}</dt>
                <dd>{r.href ? <a href={r.href}>{r.value}</a> : r.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </main>

  <footer class="home-footer">
    <div class="wrap">
      <div class="home-footer__brand">
        <span class="brand__name">Shruggie<span class="brand__dot">.</span></span>
        <span class="brand__rule" aria-hidden="true"></span>
        <span class="brand__tag">CONSULTING</span>
      </div>
      <p class="home-footer__note">{h.footer.note}</p>
      <div class="footer-links">
        <a href={routes.imprint[lang]}>{h.footer.imprint}</a>
        <a href={routes.privacy[lang]}>{h.footer.privacy}</a>
        <a href={workspaceUrl(lang)} aria-label={ui[lang].clientWorkspaceLabel}>{ui[lang].clientWorkspace}</a>
        <button type="button" data-consent-open>{h.footer.cookieSettings}</button>
      </div>
    </div>
  </footer>
</Base>

<script>
  import { initContactForm } from "../scripts/contact-form";
  initContactForm();
</script>

---
import Base from "../layouts/Base.astro";
import LegalHeader from "./LegalHeader.astro";
import { content, routes, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  page: "imprint" | "privacy";
}

const { lang, page } = Astro.props;
const c = content[lang][page];
const other = page === "imprint" ? "privacy" : "imprint";
---

<Base lang={lang} page={page}>
  <div class="legal-page">
    <LegalHeader lang={lang} page={page} back={c.back} />

    <main id="main" class:list={["legal", { "legal--privacy": page === "privacy" }]}>
      <div class="eyebrow eyebrow--on-light">{c.eyebrow}</div>
      <h1 class="display">{c.title}</h1>
      {c.intro && <p class="legal__intro">{c.intro}</p>}

      {
        c.sections.map((s) => (
          <section>
            <h2 class="display">{s.heading}</h2>
            {s.lines.map((line) => <p>{line}</p>)}
          </section>
        ))
      }

      <p class="legal__disclaimer">{c.disclaimer}</p>
    </main>

    <footer class="legal-footer">
      <div class="wrap">
        <span class="legal-footer__copy">{c.copyright}</span>
        <div class="footer-links">
          <a href={routes.home[lang]}>{c.back}</a>
          <a href={routes[other][lang]}>{c.otherLegal}</a>
        </div>
      </div>
    </footer>
  </div>
</Base>

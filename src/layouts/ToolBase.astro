---
// Document shell for one interactive tool. The tools bring their own complete stylesheet
// (same brand tokens, their own names), so this layout deliberately does not load
// global.css: only the head, the fonts and the pieces of site chrome the tool pages add.
import { meta, routes, ui, type Lang, type ToolKey } from "../i18n";
import { CF_BEACON_TOKEN } from "../analytics";

interface Props {
  lang: Lang;
  page: ToolKey;
}

const { lang, page } = Astro.props;
const m = meta[page][lang];
const site = Astro.site!;
const canonical = new URL(routes[page][lang], site).href;
const alt = (l: Lang) => new URL(routes[page][l], site).href;
const ogImage = new URL(m.ogImage, site).href;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{m.title}</title>
    <meta name="description" content={m.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={alt("de")} />
    <link rel="alternate" hreflang="en" href={alt("en")} />
    <link rel="alternate" hreflang="x-default" href={alt("de")} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/space-grotesk-latin-3.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-black-latin-1.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shruggie Consulting" />
    <meta property="og:title" content={m.title} />
    <meta property="og:description" content={m.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={m.title} />
    <meta name="twitter:description" content={m.description} />
    <meta name="twitter:image" content={ogImage} />

    <style is:global>
      @font-face { font-family: "Archivo Black"; font-weight: 400; font-display: swap; src: url(/fonts/archivo-black-latin-1.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Archivo Black"; font-weight: 400; font-display: swap; src: url(/fonts/archivo-black-latin-ext-0.woff2) format("woff2"); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: "Space Grotesk"; font-weight: 300 700; font-display: swap; src: url(/fonts/space-grotesk-latin-3.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Space Grotesk"; font-weight: 300 700; font-display: swap; src: url(/fonts/space-grotesk-latin-ext-2.woff2) format("woff2"); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      body { margin: 0; }
      [hidden] { display: none !important; }
      .tool-skip { position: absolute; left: -9999px; }
      .tool-skip:focus { left: 16px; top: 16px; z-index: 50; padding: 8px 12px; background: #161616; color: #fff; }
      /* the Shruggie Consulting lockup and the way back, in the tools' own top bar */
      .sb { display: flex; align-items: center; gap: 12px; color: var(--color-ink); text-decoration: none; min-width: 0; }
      .sb-shrug { font-size: 16px; font-weight: 500; white-space: nowrap; }
      .sb-name { font-family: var(--font-display); font-size: 20px; letter-spacing: -0.02em; text-transform: uppercase; }
      .sb-dot { color: var(--color-accent); }
      .sb-rule { width: 18px; height: 2px; background: var(--color-ink); }
      .sb-tag { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; white-space: nowrap; }
      .sb-nav { margin-left: auto; display: flex; gap: 24px; }
      .sb-nav a { padding: 8px 0; font-size: 14px; font-weight: 500; color: var(--color-ink); text-decoration: none; border-bottom: 2px solid transparent; white-space: nowrap; }
      .sb-nav a:hover { border-bottom-color: var(--color-accent); }
      .site-foot { max-width: var(--container); margin: 64px auto 0; padding-top: 20px; border-top: 1px solid var(--color-rule); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; font-size: 13px; color: var(--color-muted); }
      .site-foot nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
      .site-foot a { color: var(--color-ink-2); }
      @media (max-width: 40rem) { .sb-shrug, .sb-rule, .sb-tag { display: none; } .sb-nav { gap: 16px; } }
    </style>
  </head>
  <body>
    <a class="tool-skip" href="#step1">{ui[lang].skip}</a>
    <slot />
    {CF_BEACON_TOKEN && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}></script>
    )}
  </body>
</html>

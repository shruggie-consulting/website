---
// Consulting lived here while the house page had the root. Old links land on the root now,
// with their section (#contact, #services …) kept.
const to = "/";
const canonical = new URL(to, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Shruggie Consulting</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p><a href={to}>Shruggie Consulting</a></p>
  </body>
</html>
